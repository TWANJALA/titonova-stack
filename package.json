{
  "name": "titonova-stack",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.js",
    "start": "node api/server.js",
    "dev:api": "node api/server.js",
    "dev:studio": "(cd studio && npm run dev)",
    "build:studio": "cd studio && npm ci && npm run build",
    "build": "npm run build:studio",
    "docker:build": "docker build -t titonova-stack .",
    "docker:up": "docker-compose up --build"
  }
}
